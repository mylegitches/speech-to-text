<Window x:Class="SpeechToText.UI.RecordingPill"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight">
    <Border x:Name="Shell" CornerRadius="{StaticResource RadiusPill}" Padding="14,8" Margin="12"
            Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="Glyph" Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="16" Foreground="{StaticResource Danger}" VerticalAlignment="Center"/>
            <StackPanel x:Name="Bars" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" Height="18"/>
            <TextBlock x:Name="Label" Margin="10,0,0,0" Foreground="{StaticResource Text}" FontSize="13"
                       FontFamily="{StaticResource Sans}" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>

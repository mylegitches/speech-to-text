<Window x:Class="SpeechToText.UI.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notes · SpeechToText" Width="680" Height="640" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterScreen" Style="{StaticResource BrandWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16,20,14">
        <!-- Search + new -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Click="NewNote_Click" Margin="10,0,0,0" Style="{DynamicResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE710;" Margin="0,2,8,0"/>
                    <TextBlock Text="New note"/>
                </StackPanel>
            </Button>
            <Grid>
                <TextBox x:Name="Search" TextChanged="Search_Changed" AutomationProperties.Name="Search notes"/>
                <TextBlock x:Name="SearchHint" Text="Search notes" IsHitTestVisible="False" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </DockPanel>

        <!-- Footer: file, undo -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Open folder" Click="OpenFolder_Click"/>
            <Border x:Name="UndoBar" DockPanel.Dock="Right" Visibility="Collapsed" Margin="0,0,10,0" Padding="12,4"
                    CornerRadius="{StaticResource RadiusControl}" Background="{StaticResource Surface2}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Note moved to deleted notes" VerticalAlignment="Center"/>
                    <Button Content="Undo" Margin="10,0,0,0" Padding="10,2" Click="Undo_Click"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="Footer" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid>
            <!-- Empty state -->
            <TextBlock x:Name="Empty" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="40,0"/>

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                <ItemsControl x:Name="List" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusCard}" Padding="14,10,8,10" Margin="0,0,4,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" ToolTip="{Binding KindLabel}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Foreground="{StaticResource AccentText}" Margin="0,3,0,0" AutomationProperties.Name="{Binding KindLabel}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding When}" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                                   Foreground="{StaticResource Muted}" Margin="0,0,0,4"
                                                   Visibility="{Binding HasWhen, Converter={StaticResource Vis}}"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MouseLeftButtonDown="Text_MouseDown"
                                                   ToolTip="Double-click to edit" Cursor="IBeam"
                                                   Visibility="{Binding IsViewing, Converter={StaticResource Vis}}"/>
                                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False"
                                                 Visibility="{Binding IsEditing, Converter={StaticResource Vis}}"
                                                 IsVisibleChanged="Editor_IsVisibleChanged" PreviewKeyDown="Editor_KeyDown" LostKeyboardFocus="Editor_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy"
                                                AutomationProperties.Name="Copy note" Click="Copy_Click"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete (can be undone)"
                                                AutomationProperties.Name="Delete note" Click="Delete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>

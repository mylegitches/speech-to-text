<Window x:Class="SpeechToText.UI.TextNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New note · SpeechToText" Width="560" Height="440" MinWidth="380" MinHeight="260"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        Style="{StaticResource BrandWindow}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                   Text="Paste keeps formatting and images · Ctrl+B bold · Ctrl+I italic · Ctrl+Shift+L bullets · Ctrl+D dictate · Ctrl+Enter saves"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="MicBtn" DockPanel.Dock="Left" Click="Mic_Click" MinWidth="110"
                    ToolTip="Dictate into the note at the cursor (Ctrl+D)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MicGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE720;"
                               VerticalAlignment="Center" Margin="0,1,8,0"/>
                    <TextBlock x:Name="MicLabel" Text="Dictate" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="80"/>
                <Button x:Name="SaveBtn" Content="Save" MinWidth="80" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}"/>
            </StackPanel>
        </DockPanel>
        <RichTextBox x:Name="Body" AcceptsReturn="True" AcceptsTab="False" VerticalScrollBarVisibility="Auto"
                     IsDocumentEnabled="True" SpellCheck.IsEnabled="True" AutomationProperties.Name="Note"/>
    </DockPanel>
</Window>

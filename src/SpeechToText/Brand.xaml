<!--
  OwMyContext family tokens (branding/tokens.json, verified) mapped onto WPF's Fluent theme keys.
  Dark-only: light mode is an open owner decision in OwMyContext, dark-only is the accepted default.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== tokens ===== -->
    <Color x:Key="BgColor">#0f1117</Color>
    <Color x:Key="SurfaceColor">#1a1d27</Color>
    <Color x:Key="Surface2Color">#232736</Color>
    <Color x:Key="BorderColor">#2c2f3e</Color>
    <Color x:Key="TextColor">#e2e8f0</Color>
    <Color x:Key="MutedColor">#8492a6</Color>
    <Color x:Key="SuccessColor">#22c55e</Color>
    <Color x:Key="WarningColor">#f59e0b</Color>
    <Color x:Key="DangerColor">#ef4444</Color>
    <Color x:Key="DangerFillColor">#dc2626</Color>
    <Color x:Key="AccentColor">#095b1b</Color>
    <Color x:Key="AccentHColor">#0c7424</Color>
    <Color x:Key="AccentTextColor">#4cc26a</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerFill" Color="{StaticResource DangerFillColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentH" Color="{StaticResource AccentHColor}"/>
    <SolidColorBrush x:Key="AccentText" Color="{StaticResource AccentTextColor}"/>

    <FontFamily x:Key="Sans">Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">JetBrains Mono, Fira Code, Consolas</FontFamily>
    <sys:Double x:Key="BodySize">13</sys:Double>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusPill">99</CornerRadius>

    <!-- ===== Fluent theme overrides (keys from PresentationFramework.Fluent) ===== -->
    <Color x:Key="SystemAccentColor">#0c7424</Color>
    <Color x:Key="SystemAccentColorSecondary">#095b1b</Color>
    <Color x:Key="SystemAccentColorLight1">#0c7424</Color>
    <Color x:Key="SystemAccentColorLight2">#4cc26a</Color>
    <Color x:Key="SystemAccentColorLight3">#4cc26a</Color>
    <Color x:Key="SystemAccentColorDark1">#095b1b</Color>
    <Color x:Key="SystemAccentColorDark2">#095b1b</Color>
    <Color x:Key="SystemAccentColorDark3">#095b1b</Color>

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource MutedColor}"/>

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorPrimaryBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentHColor}"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentHColor}"/>
    <SolidColorBrush x:Key="AccentDefaultBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentHColor}"/>
    <SolidColorBrush x:Key="AccentTertiaryBrush" Color="{StaticResource AccentHColor}"/>
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{StaticResource AccentHColor}"/>
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="{StaticResource AccentHColor}"/>
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource AccentTextColor}"/>

    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource AccentHColor}"/>
    <SolidColorBrush x:Key="KeyboardFocusBorderColorBrush" Color="{StaticResource AccentHColor}"/>
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{StaticResource AccentHColor}"/>

    <!-- ===== shared styles ===== -->
    <Style x:Key="BrandWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Sans}"/>
        <Setter Property="FontSize" Value="{StaticResource BodySize}"/>
        <Setter Property="Icon" Value="pack://application:,,,/Assets/app.ico"/>
    </Style>
</ResourceDictionary>
